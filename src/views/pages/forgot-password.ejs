<%- include("../partials/auth-start", { title: "Forgot Password", image: "/images/image-5.jpg", backHref: "/login" }) %>

<% const err = (n) => locals.errors?.[n]; %>

<h1>Forgot Password</h1>
<p class="auth-sub">Enter your email and we'll send you a link to reset your password.</p>

<% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
<% if (err("form")) { %><p class="auth-error" role="alert"><%= err("form") %></p><% } %>

<form method="post" action="/forgot-password" class="auth-form" novalidate>
  <%- include("../partials/csrf") %>

  <div class="field">
    <input type="email" id="email" name="email" autocomplete="email" placeholder=" "
           value="<%= locals.values?.email ?? '' %>"
           <%- err("email") ? 'aria-invalid="true" aria-describedby="email-error"' : '' %> required>
    <label for="email">Email</label>
  </div>
  <% if (err("email")) { %><p class="field-error" id="email-error"><%= err("email") %></p><% } %>

  <button type="submit" class="btn-primary">Send reset link</button>
</form>

<p class="resend"><a href="/login">Back to log in</a></p>

<%- include("../partials/auth-end") %>
