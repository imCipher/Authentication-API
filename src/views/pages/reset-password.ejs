<%- include("../partials/auth-start", { title: "Reset Password", image: "/images/image-5.jpg", backHref: "/login" }) %>

<%
  const err = (n) => locals.errors?.[n];
  const aria = (n) => err(n) ? `aria-invalid="true" aria-describedby="${n}-error"` : "";
%>

<h1>Reset Password</h1>

<% if (expired) { %>
  <!-- dead link: retyping can't help, so no form -->
  <p class="auth-error" role="alert">This reset link is invalid or has expired.</p>
  <a href="/forgot-password" class="btn-primary">Request a new link</a>

<% } else { %>
  <p class="auth-sub">Choose a new password. You'll be logged out on every device.</p>
  <% if (err("form")) { %><p class="auth-error" role="alert"><%= err("form") %></p><% } %>

  <form method="post" action="/reset-password/<%= encodeURIComponent(token) %>" class="auth-form" novalidate>
    <%- include("../partials/csrf") %>

    <div class="field field-password">
      <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" placeholder=" "
             <%- aria("newPassword") %> required>
      <label for="newPassword">New password</label>
      <button type="button" class="field-password__toggle" aria-label="Hold to show password">
        <img src="/images/eye-closed.svg" alt="" width="24" height="24">
      </button>
    </div>
    <% if (err("newPassword")) { %><p class="field-error" id="newPassword-error"><%= err("newPassword") %></p><% } %>

    <div class="field field-password">
      <input type="password" id="confirmNewPassword" name="confirmNewPassword" autocomplete="new-password" placeholder=" "
             <%- aria("confirmNewPassword") %> required>
      <label for="confirmNewPassword">Confirm new password</label>
      <button type="button" class="field-password__toggle" aria-label="Hold to show password">
        <img src="/images/eye-closed.svg" alt="" width="24" height="24">
      </button>
    </div>
    <% if (err("confirmNewPassword")) { %><p class="field-error" id="confirmNewPassword-error"><%= err("confirmNewPassword") %></p><% } %>

    <button type="submit" class="btn-primary">Reset password</button>
  </form>
<% } %>

<%- include("../partials/auth-end", { scripts: ["/js/scripts.js"] }) %>
