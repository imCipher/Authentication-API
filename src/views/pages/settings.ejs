<%- include("../partials/app-start", { title: "Settings", active: "settings" }) %>

<section class="page-head">
  <h1>Settings</h1>
  <p class="muted">Manage your profile, password and sessions.</p>
</section>

<% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>

<div class="stack">
  <!-- Profile -->
  <section class="card">
    <h2>Profile</h2>
    <% if (errors.profile) { %><p class="auth-error" role="alert"><%= errors.profile %></p><% } %>

    <form method="post" action="/settings/profile" class="auth-form">
      <%- include("../partials/csrf") %>
      <div class="field">
        <input id="fullName" name="fullName" autocomplete="name" placeholder=" "
               value="<%= values.fullName ?? user.fullName ?? '' %>">
        <label for="fullName">Full name</label>
      </div>
      <div class="field">
        <input id="username" name="username" autocomplete="username" placeholder=" "
               value="<%= values.username ?? user.username ?? '' %>">
        <label for="username">Username</label>
      </div>
      <div class="field">
        <input id="email" value="<%= user.email %>" placeholder=" " disabled>
        <label for="email">Email (can't be changed yet)</label>
      </div>
      <button type="submit" class="btn-primary">Save changes</button>
    </form>
  </section>

  <!-- Password -->
  <section class="card">
    <h2>Password</h2>

    <% if (hasPassword) { %>
      <p class="muted">Changing your password logs you out on every device.</p>
      <% if (errors.password) { %><p class="auth-error" role="alert"><%= errors.password %></p><% } %>
            <form method="post" action="/settings/password" class="auth-form">
        <%- include("../partials/csrf") %>
        <div class="field">
          <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" placeholder=" " required>
          <label for="currentPassword">Current password</label>
        </div>
        <div class="field">
          <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" placeholder=" " required>
          <label for="newPassword">New password</label>
        </div>
        <div class="field">
          <input type="password" id="confirmNewPassword" name="confirmNewPassword" autocomplete="new-password" placeholder=" " required>
          <label for="confirmNewPassword">Confirm new password</label>
        </div>
        <button type="submit" class="btn-primary">Change password</button>
      </form>

    <% } else { %>
      <p class="muted">
        You signed in with Google, so this account doesn't have a password yet.
        Set one if you'd also like to log in with your email.
      </p>
      <form method="post" action="/settings/password-link">
        <%- include("../partials/csrf") %>
        <button type="submit" class="btn-primary">Email me a link to set a password</button>
      </form>
    <% } %>
  </section>


  <!-- Sessions -->
  <section class="card">
    <h2>Sessions</h2>
    <p class="muted">Signed in on a device you don't recognise? Log out everywhere.</p>
    <form method="post" action="/settings/logout-all">
      <%- include("../partials/csrf") %>
      <button type="submit" class="btn-danger">Log out of all devices</button>
    </form>
  </section>
</div>

<%- include("../partials/app-end") %>
