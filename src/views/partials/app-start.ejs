<%- include("head", { title }) %>
<body class="app">
  <header class="app-nav">
    <a href="/dashboard" class="app-nav__brand">
      <img src="/images/logo.svg" alt="" width="32" height="32"> <span>Auth</span>
    </a>

    <nav class="app-nav__links" aria-label="Main">
      <a href="/dashboard" aria-current="<%= locals.active === 'dashboard' ? 'page' : 'false' %>">Dashboard</a>
      <a href="/settings"  aria-current="<%= locals.active === 'settings'  ? 'page' : 'false' %>">Settings</a>
      <% if (locals.user?.role === "ADMIN") { %>
        <a href="/admin/users" aria-current="<%= locals.active === 'admin' ? 'page' : 'false' %>">Admin</a>
      <% } %>
    </nav>

    <form method="post" action="/logout">
      <%- include("csrf") %>
      <button type="submit" class="btn-ghost">Log out</button>
    </form>
  </header>
  <main class="app-main">
