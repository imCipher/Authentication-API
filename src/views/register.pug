extends baseEmail

block content
  p Hi #{firstName},
  p Confirm your email address by using the code below: #{code}.
  p (Website for this action not yet implemented.)
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Confirm your email
  p If you didn't request to confirm your email, please ignore this email!
